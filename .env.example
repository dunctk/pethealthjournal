APP_HOST=0.0.0.0
APP_PORT=3000
APP_USERNAME=owner
APP_PASSWORD=change-me
PRODUCTION=false
# Deployment mode is independent of PRODUCTION. Defaults to self_hosted when unset.
DEPLOYMENT_MODE=self_hosted
# Reserved for future opt-in proactive AI; not a working scheduler.
# Off by default. True on self-hosted needs your own provider key.
# True on managed is blocked until per-household paid entitlement checks exist.
PROACTIVE_AI_ENABLED=false
# Optional Google OAuth login ("Continue with Google"). Both or neither.
# Hidden from the UI unless both are set. Register the exact redirect URI
# in Google Cloud Console → Credentials → Authorized redirect URIs:
#   https://YOUR-HOST/oauth/google/callback
# (redirect is request-origin derived, or APP_BASE_URL when set).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional only for managed deployments; both or neither must be set.
# In self_hosted mode these are ignored, even if supplied.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
DATABASE_URL=sqlite://./data/pethealth.sqlite?mode=rwc
# Production always resolves the database to /persistent/pethealth.sqlite.
# Optional Rig/OpenRouter-compatible model configuration. Either key name is
# accepted; LLM_API_KEY is kept for backwards compatibility.
LLM_API_KEY=
OPENROUTER_API_KEY=
# These two are optional OpenAI-compatible overrides.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-5.6-sol
# Seconds to wait on the capture extraction call before giving up (default 20).
LLM_TIMEOUT_SECONDS=20
# Private appearance-photo storage. Production compose defaults this under /persistent.
PET_PHOTOS_DIR=./data/pet_photos
